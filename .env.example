# =============================================================================
# Barberic Culture Media OS — environment variables
# Copy this file to .env.local and fill in values as you sign up for services.
# The app will boot with NONE of these set; each integration unlocks as you
# add its keys. See SETUP.md for step-by-step instructions.
# =============================================================================

# -- Database / Auth (Supabase) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- AI (OpenAI) — transcription + content generation -------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# -- Object storage (Cloudflare R2, S3-compatible) ----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=barberic-media-os-prod
R2_PUBLIC_BASE_URL=

# -- YouTube (Google Cloud OAuth client) --------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# -- App config ---------------------------------------------------------------
APP_URL=http://localhost:3000
ADMIN_EMAIL=

# -- Optional integrations (feature-flagged; safe to leave blank) -------------
OPUSCLIP_API_KEY=
DESCRIPT_API_KEY=
MAKE_WEBHOOK_URL=
